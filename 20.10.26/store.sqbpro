CREATE TABLE IF NOT EXISTS StoreOrders (
    Id INTEGER PRIMARY KEY AUTOINCREMENT,
    CustomerName TEXT NOT NULL,
    ProductName TEXT NOT NULL,
    Category TEXT NOT NULL,
    Price REAL NOT NULL,
    Quantity INTEGER NOT NULL
);

